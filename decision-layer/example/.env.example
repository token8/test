# Copy to <product>/.env (git-ignored, manifesto §11) and fill in. Rotate the key quarterly.
TYPESAFE_API_KEY=
# JEV_MODEL=jev-1.13.0            # pin for a release; default jev-latest
# JEV_URL=https://api.typesafe.ai/v1/systemone   # or a LiteLLM pass-through
# LAYA_URL=http://127.0.0.1:8771  # laya-serve (decision-layer/docker) or decision_layer.sidecar
# LAYA_MODEL=                     # empty: laya-serve routes per email (German -> multilingual)
# LAYA_API_KEY=                   # only if laya-serve runs with LAYA_API_KEY
# DECISION_REMOTE=0               # kill switch: nothing leaves the machine
# DECISION_LOG_DIR=logs
